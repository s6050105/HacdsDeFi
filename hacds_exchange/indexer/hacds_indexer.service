[Unit]
Description=HacdsDeFi on-chain indexer (borrower watchlist for the liquidation console)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hacds-indexer
# 索引器是只读消费者：只 GET 节点 RPC，从不提交交易、不需要私钥、不需要余额。
#
# ⚠ 显式写 --host 与 --read-only（2026-10-26）：
#   代码里的默认值已经是安全的（127.0.0.1 + 只读），但单元文件写明更稳——
#   将来若有人改了默认值，这里不会跟着变成「公网可写」。
#
#   若钱包需要经由索引器增删台账，把 --read-only 换成 --allow-write，
#   并配合 HACDS_CORS_ORIGINS 限制来源。
ExecStart=/usr/bin/python3 /opt/hacds-indexer/hacds_indexer.py serve \
    --node http://127.0.0.1:8082 \
    --host 127.0.0.1 \
    --port 8124 \
    --read-only \
    --interval 60 --window 500 --workers 4
Restart=always
RestartSec=10

# M-6：不再以 root 运行（原单元文件是 `User=root`）。
# 索引器只读节点、只写自己的台账与日志，没有任何理由要 root。
#
# 部署前创建用户与目录（只需一次）：
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin hacds
#   sudo mkdir -p /opt/hacds-indexer /var/log
#   sudo chown -R hacds:hacds /opt/hacds-indexer
#   sudo touch /var/log/hacds-indexer.log
#   sudo chown hacds:hacds /var/log/hacds-indexer.log
User=hacds
Group=hacds

# 不需要任何特权；日志与台账是唯一写入点
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /opt/hacds-indexer

StandardOutput=append:/var/log/hacds-indexer.log
StandardError=append:/var/log/hacds-indexer.log

[Install]
WantedBy=multi-user.target
