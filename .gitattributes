# 统一换行：仓库内一律 LF（避免 Windows 上提交把文本转成 CRLF）
* text=auto eol=lf

# 明确按文本处理
*.md    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.fitsh text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.nsh   text eol=lf
*.service text eol=lf

# 二进制：不做任何转换
*.png   binary
*.jpg   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.docx  binary
*.wasm  binary
*.exe   binary

# 语言统计
*.fitsh linguist-language=Solidity
*.md    linguist-documentation
